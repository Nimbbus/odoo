   <odoo>

    <template id="report_estate_property_offers">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="property">
                <div class="page">
                    <h2>Offers for <t t-esc="property.name"/></h2>
                    <t t-if="property.offer_ids">
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Partner</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="property.offer_ids" t-as="offer">
                                    <tr>
                                        <td><t t-esc="offer.partner_id.name"/></td>
                                        <td><t t-esc="offer.price"/></td>
                                        <td><t t-esc="offer.status"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <t t-else="">
                        <p>No offers yet for this property.</p>
                    </t>
                </div>
            </t>
        </t>
    </template>
    
</odoo>